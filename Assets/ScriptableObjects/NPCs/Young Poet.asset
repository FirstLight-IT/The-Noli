  m_Script: {fileID: 11500000, guid: 7560214a2c335bd4e9cc29951d82c1e3, type: 3}
  m_Name: Young Poet
  m_EditorClassIdentifier: Assembly-CSharp::NPCInfoSO
  npcID: young_poet
  displayName: Young Poet
  characterFullName: "A\u2014\u2014\u2014"
  alias: Strange Youth
  characterCategory: Writer / Civilian Guest
  portrait: {fileID: 0}
  description: A young Filipino poet who has stopped writing because he refuses to
    produce dishonest or degrading work. His brief appearance reveals the dangers
    faced by writers who express uncomfortable truths.
  biography: "The Young Poet introduces himself to Ibarra only as \u201CA\u2014\u2014\u2014,\u201D
    leaving his complete identity undisclosed. Ibarra recognizes him as a poet whose
    works helped preserve his enthusiasm for the Philippines while he was abroad.
    The poet explains that he no longer writes because truthful expression can lead
    to imprisonment or exile. He then withdraws from the group after referring to
    a writer who was nearly exiled for placing an obvious truth into verse."
  characterFacts:
  - His complete name is deliberately withheld.
  - "He identifies himself only as \u201CA\u2014\u2014\u2014.\u201D"
  - He is recognized by Ibarra as a poet.
  - His writing inspired Ibarra while he was in Europe.
  - He has stopped writing.
  - He refuses to lie or degrade himself through his work.
  - He mentions that a writer was imprisoned for expressing a truth in verse.
  - He represents the risks faced by writers under colonial censorship.
  introductionLines: []
  repeatDialogues: []
