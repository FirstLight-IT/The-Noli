  m_Script: {fileID: 11500000, guid: 7560214a2c335bd4e9cc29951d82c1e3, type: 3}
  m_Name: Tiburcio
  m_EditorClassIdentifier: Assembly-CSharp::NPCInfoSO
  npcID: don_tiburcio
  displayName: Don Tiburcio
  characterFullName: "Tiburcio de Espada\xF1a"
  alias: "Doctor de Espada\xF1a"
  characterCategory: Civilian / Physician
  portrait: {fileID: 21300000, guid: c01fa19f22a567d4a9cab5e615ca8a9d, type: 3}
  description: "A timid and physically impaired Spanish doctor who speaks with a
    stutter. He is the husband of the proud and outspoken Do\xF1a Victorina."
  biography: "Don Tiburcio de Espada\xF1a attends Capit\xE1n Tiago\u2019s dinner
    with his wife, Do\xF1a Victorina. He is described as lame and answers others
    mostly in short phrases because of his stutter. During dinner, he shyly attempts
    to join the conversation by asking Ibarra whether he encountered a Polish acquaintance
    while traveling in Europe. His quiet and hesitant behavior contrasts sharply
    with his wife\u2019s forceful personality."
  characterFacts:
  - "He is married to Do\xF1a Victorina."
  - He is Spanish.
  - He has a noticeable stutter.
  - He is timid and speaks cautiously.
  - His wife frequently speaks more confidently than he does.
  introductionLines:
  - "Doctor de Espada\xF1a, at your service."
  repeatDialogues:
  - lines:
    - This gathering is quite lively.
    - I believe I am more comfortable observing the conversation than joining its
      disputes.
