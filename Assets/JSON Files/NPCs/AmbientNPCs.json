          "languageCode": "en",
          "displayName": "Newspaper Reporter",
          "dialogueVariations": [
            {
              "lines": [
                "There may be something worth writing about before the evening is over."
              ]
            },
            {
              "lines": [
                "Everyone is speaking, but no one is saying anything suitable for print."
              ]
            },
            {
              "lines": [
                "I should remember who attended tonight. The names may become useful later."
              ]
            }
          ],
          "chapterDialogues": [
