        },
        {
          "languageCode": "fil",
          "displayName": "Tindero",
          "dialogueVariations": [
            {
              "lines": [
                "Mahina ang negosyo, ngunit mainam ang ganitong mga pagtitipon upang makatagpo ng mga mamimili."
              ]
            },
            {
              "lines": [
                "Nakita mo ba ang mga dekorasyon? Tiyak na malaki ang ginastos para sa mga iyon."
              ]
            },
            {
              "lines": [
                "Kilala ko sa mukha ang ilan sa mga narito, bagaman kakaunti lamang ang kilala ko sa pangalan."
              ]
            }
          ],
