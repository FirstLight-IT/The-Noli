          "displayName": "Mamamahayag",
          "dialogueVariations": [
            {
              "lines": [
                "Maaaring may mangyaring karapat-dapat isulat bago matapos ang gabi."
              ]
            },
            {
              "lines": [
                "Nagsasalita ang lahat, ngunit walang nagsasabi ng anumang angkop ilathala."
              ]
            },
            {
              "lines": [
                "Dapat kong tandaan kung sino ang mga dumalo ngayong gabi. Maaaring mapakinabangan ang mga pangalan nila balang araw."
              ]
            }
          ],
