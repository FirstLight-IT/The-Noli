          "languageCode": "en",
          "displayName": "House Servant",
          "dialogueVariations": [
            {
              "lines": [
                "Everything must be ready before the guests begin complaining."
              ]
            },
            {
              "lines": [
                "Careful around the plates. We have already broken enough for one evening."
              ]
            },
            {
              "lines": [
                "Pardon me. I must carry these dishes to the dining table."
              ]
            }
          ],
