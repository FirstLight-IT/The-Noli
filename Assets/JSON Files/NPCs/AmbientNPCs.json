          "languageCode": "en",
          "displayName": "Shopkeeper",
          "dialogueVariations": [
            {
              "lines": [
                "Business has been slow, but gatherings like this are good for meeting customers."
              ]
            },
            {
              "lines": [
                "Have you seen the decorations? They must have cost a considerable amount."
              ]
            },
            {
              "lines": [
                "I know several people here by face, though very few by name."
              ]
            }
          ],
          "chapterDialogues": [
