          "displayName": "Musikero",
          "dialogueVariations": [
            {
              "lines": [
                "Lalong lumalakas ang ingay ng mga panauhin. Baka kailangan nating tumugtog nang mas malakas."
              ]
            },
            {
              "lines": [
                "Panatilihing pantay ang kumpas. Nagsisimula pa lamang ang gabi."
              ]
            },
            {
              "lines": [
                "Isa pang tugtugin pagkatapos nito, maliban kung tawagin na rin sa wakas ang lahat para sa hapunan."
              ]
            }
          ],
