    {
      "npcId": "ambient_gentleman",
      "languages": [
        {
          "languageCode": "en",
          "displayName": "Gentleman",
          "dialogueVariations": [
            {
              "lines": [
                "A fine gathering, is it not? Capitan Tiago has spared no expense."
              ]
            },
            {
              "lines": [
                "I believe we have not been formally introduced."
              ]
            },
            {
              "lines": [
                "The conversation has become rather tense. It may be wiser to remain here."
              ]
            }
          ],
          "missionDialogueOverrides": [
            {
              "missionId": "introduce_yourself",
              "dialogueVariations": [
                {
                  "lines": [
                    "Ah, Señor Ibarra. It is an honor to make your acquaintance."
                  ]
                },
                {
                  "lines": [
                    "Welcome home, Señor Ibarra. We have heard of your studies in Europe."
                  ]
                },
                {
                  "lines": [
                    "Good evening. Capitan Tiago must be pleased to see you safely returned."
                  ]
                }
              ]
            }
          ],
          "chapterDialogues": [
            {
              "chapterId": "chapter_1",
              "dialogueVariations": [
                {
                  "lines": [
                    "[PLACEHOLDER][chapter_1][ambient_gentleman][en] Default dialogue."
                  ]
                }
              ]
            },
            {
              "chapterId": "chapter_2",
              "dialogueVariations": [
                {
                  "lines": [
                    "[PLACEHOLDER][chapter_2][ambient_gentleman][en] Default dialogue."
                  ]
