    {
      "npcId": "ambient_foreign_guest",
      "languages": [
        {
          "languageCode": "en",
          "displayName": "Foreign Guest",
          "dialogueVariations": [
            {
              "lines": [
                "We have walked across this room several times already."
              ]
            },
            {
              "lines": [
                "There is much noise, yet very little appears to be happening."
              ]
            },
            {
              "lines": [
                "Perhaps the meal will provide more interest than the conversation."
              ]
            }
          ],
          "chapterDialogues": [
