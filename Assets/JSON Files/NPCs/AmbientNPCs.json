      "languages": [
        {
          "languageCode": "en",
          "displayName": "Musician",
          "dialogueVariations": [
            {
              "lines": [
                "The guests are growing louder. We may have to play with greater force."
              ]
            },
            {
              "lines": [
                "Keep the tempo steady. The evening has only just begun."
              ]
            },
            {
              "lines": [
                "Another piece after this one, unless they finally call everyone to dinner."
              ]
            }
          ],
