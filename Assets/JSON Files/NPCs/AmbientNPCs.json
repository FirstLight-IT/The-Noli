            },
            {
              "chapterId": "chapter_3",
              "dialogueVariations": [
                {
                  "lines": [
                    "[PLACEHOLDER][chapter_3][ambient_gentleman][en] Default dialogue."
                  ]
                }
              ]
            }
          ]
        },
        {
          "languageCode": "fil",
          "displayName": "Ginoo",
          "dialogueVariations": [
            {
              "lines": [
                "Magandang pagtitipon, hindi ba? Hindi nagtipid si Kapitan Tiago."
              ]
            },
            {
              "lines": [
                "Sa palagay ko ay hindi pa tayo pormal na naipakilala sa isa't isa."
              ]
            },
            {
              "lines": [
                "Medyo umiigting na ang usapan. Marahil ay mas mabuting manatili rito."
              ]
            }
          ],
          "missionDialogueOverrides": [
            {
              "missionId": "introduce_yourself",
              "dialogueVariations": [
                {
                  "lines": [
                    "Ah, Señor Ibarra. Isang karangalang makilala kayo."
                  ]
                },
                {
                  "lines": [
                    "Maligayang pagbabalik, Señor Ibarra. Nabalitaan namin ang inyong pag-aaral sa Europa."
                  ]
                },
                {
                  "lines": [
                    "Magandang gabi. Tiyak na natutuwa si Kapitan Tiago sa inyong ligtas na pagbabalik."
                  ]
                }
              ]
            }
          ],
          "chapterDialogues": [
            {
              "chapterId": "chapter_1",
              "dialogueVariations": [
