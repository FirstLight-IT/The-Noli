{
  "conversationId": "leave_the_gathering",
  "defaultLanguageCode": "en",
  "languages": [
    {
      "languageCode": "en",
      "lines": [
        {
          "speakerId": "crisostomo_ibarra",

          "facingTargetId": "player",
          "text": "You will now permit me to retire, since, as I have just arrived and must go away tomorrow morning."
        }, {
          "speakerId": "crisostomo_ibarra",

          "facingTargetId": "player",
          "text": "There remain some important business matters for me to attend to."
        }, {
          "speakerId": "crisostomo_ibarra",

          "facingTargetId": "player",
          "text": "Gentlemen, all for Spain and the Philippines!"
        }, {
          "speakerId": "capitan_tiago",

          "facingTargetId": "player",
          "text": "Don't go!"
        }, {
          "speakerId": "capitan_tiago",

          "facingTargetId": "player",
          "text": "Maria Clara will be here. Isabel has gone to get her."
        }, {
          "speakerId": "capitan_tiago",

          "facingTargetId": "player",
          "text": "The new curate of your town, who is a saint, is also coming."
        }, {
          "speakerId": "crisostomo_ibarra",

          "facingTargetId": "player",
          "text": "I'll call tomorrow before starting."
        }, {
          "speakerId": "crisostomo_ibarra",

          "facingTargetId": "player",
          "text": "I've a very important visit to make now."
        }
      ]
    },
    {
      "languageCode": "fil",
      "lines": [
         {
          "speakerId": "crisostomo_ibarra",

          "facingTargetId": "player",
          "text": "Itulot ninyo sa aking ako'y umalis na, sapagkat bago akong dating at dahil bukas din ay ako'y aalis."
        }, {
          "speakerId": "crisostomo_ibarra",

          "facingTargetId": "player",
          "text": "Marami pa akong mahalagang bagay na kailangang gawin."
        }, {
          "speakerId": "crisostomo_ibarra",

          "facingTargetId": "player",
          "text": "Mga ginoo, matungkol nawa ang lahat sa Espanya at Pilipinas!"
        }, {
          "speakerId": "capitan_tiago",

          "facingTargetId": "player",
          "text": "Huwag po kayong umalis!"
        }, {
          "speakerId": "capitan_tiago",

          "facingTargetId": "player",
          "text": "Darating na si Maria Clara. Sinundo siya ni Isabel."
        }, {
          "speakerId": "capitan_tiago",

          "facingTargetId": "player",
          "text": "Paririto rin ang bagong kura ng inyong bayan, na isang tunay na santo."
        }, {
          "speakerId": "crisostomo_ibarra",

          "facingTargetId": "player",
          "text": "Paririto ako bukas bago ako umalis."
        }, {
          "speakerId": "crisostomo_ibarra",

          "facingTargetId": "player",
          "text": "Ngayon ay may gagawin akong mahalagang pagdalaw."
        }
      ]
    }
  ]
}
